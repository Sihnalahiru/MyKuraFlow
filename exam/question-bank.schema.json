{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mykuraflow.app/schemas/exam-question-bank.v1.json",
  "title": "MyKuraFlow SSW Logistics Warehouse Exam Question Bank v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "minimumDistinctQuestions",
    "sourceRevision",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "mykuraflow.question-bank.v1"
    },
    "status": {
      "enum": [
        "BUILDING_NOT_RELEASE_READY",
        "REVIEW_IN_PROGRESS",
        "RELEASE_READY"
      ]
    },
    "minimumDistinctQuestions": {
      "const": 500
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "section",
        "examType",
        "questionText",
        "sourcePage",
        "explanation",
        "reviewStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^MKF-[A-Z]{2}-[0-9]{4}$"
        },
        "section": {
          "enum": [
            "warehouse_fundamentals",
            "receiving_dispatch",
            "storage_picking",
            "distribution_processing",
            "occupational_safety_health",
            "equipment_forklift"
          ]
        },
        "examType": {
          "enum": [
            "written_true_false",
            "practical_mcq"
          ]
        },
        "questionText": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 12
            },
            "ja": {
              "type": "string"
            },
            "si": {
              "type": "string"
            },
            "technicalTermsJa": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "statement": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-D]$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "correctAnswer": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D"
              ]
            }
          ]
        },
        "explanation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "si"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 10
            },
            "si": {
              "type": "string",
              "minLength": 10
            },
            "technicalNoteJa": {
              "type": "string"
            }
          }
        },
        "sourcePage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 123
        },
        "sourceAnchor": {
          "type": "string",
          "minLength": 8
        },
        "visualRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetPath",
            "reviewStatus"
          ],
          "properties": {
            "assetPath": {
              "type": "string",
              "minLength": 1
            },
            "reviewStatus": {
              "enum": [
                "PENDING",
                "VISUALLY_VERIFIED"
              ]
            },
            "sourceVisualDescription": {
              "type": "string"
            }
          }
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "reviewStatus": {
          "enum": [
            "DRAFT",
            "SOURCE_CHECKED",
            "LANGUAGE_CHECKED",
            "VISUAL_CHECKED",
            "APPROVED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "examType": {
                "const": "written_true_false"
              }
            },
            "required": [
              "examType"
            ]
          },
          "then": {
            "required": [
              "statement",
              "correctAnswer"
            ],
            "properties": {
              "correctAnswer": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "examType": {
                "const": "practical_mcq"
              }
            },
            "required": [
              "examType"
            ]
          },
          "then": {
            "required": [
              "options",
              "correctAnswer",
              "visualRef"
            ],
            "properties": {
              "correctAnswer": {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
